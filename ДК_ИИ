                console.warn('⚠️ Ошибка инициализации:', e);
                tasks = getDefaultTasks();
            }

            // Если риски не загрузились или пустые
            if (!risks || risks.length === 0) {
                risks = [];
                renderRisks(risks);
            }

            loader.classList.add('hidden');
            table.classList.remove('hidden');
            renderTable();

            setInterval(checkForUpdates, 15000);
            console.log('🔄 Автообновление включено (каждые 15 секунд)');
        }

