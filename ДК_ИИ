<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Дорожная карта ОЗП 2.0</title>
    <style>
        /* ===== БАЗОВЫЕ СТИЛИ ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #f0f5fb;
            --surface: rgba(255, 255, 255, 0.85);
            --text: #0b2b4a;
            --text-secondary: #1f4665;
            --border: rgba(60, 100, 140, 0.12);
            --accent: #1f6b9e;
            --danger: #c94a4a;
            --success: #2f8f4b;
            --warning: #e6b422;
            --purple: #7c3aed;
            --radius: 16px;
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
            --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        [data-theme="dark"] {
            --bg: #0f1a2b;
            --surface: rgba(20, 35, 55, 0.92);
            --text: #e8edf3;
            --text-secondary: #8ab0d0;
            --border: rgba(100, 150, 200, 0.15);
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            padding: 1rem;
            display: flex;
            justify-content: center;
            color: var(--text);
            transition: background 0.3s, color 0.3s;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            width: 100%;
            background: var(--surface);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 1.2rem 1.5rem 1.5rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: background 0.3s;
        }

        /* ===== ШАПКА ===== */
        .header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.2rem;
            gap: 0.8rem;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 200px;
        }

        .header-left .title-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 150px;
        }

        .header-left .title-display {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
            padding: 2px 4px;
            cursor: default;
            word-break: break-word;
            line-height: 1.3;
            flex: 1;
        }

        .header-left .title-display span {
            background: linear-gradient(135deg, #0b2b4a, #1b4a7a);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        [data-theme="dark"] .header-left .title-display span {
            background: linear-gradient(135deg, #6aafd4, #3d8ec4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-left .title-input {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
            background: transparent;
            border: none;
            border-bottom: 2px solid var(--accent);
            padding: 2px 8px;
            min-width: 150px;
            width: 100%;
            font-family: var(--font);
            outline: none;
            display: none;
        }

        .header-left .title-input:focus {
            outline: none;
        }

        .header-left .title-edit-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            opacity: 0.3;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 30px;
            transition: all 0.2s;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .header-left .title-edit-btn:hover {
            opacity: 0.8;
            background: rgba(255, 255, 255, 0.05);
        }

        .header-left .title-edit-btn.active {
            opacity: 1;
            color: var(--accent);
        }

        .header-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn {
            padding: 5px 12px;
            border-radius: 40px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.08);
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text);
            cursor: pointer;
            transition: 0.2s;
            font-family: var(--font);
            white-space: nowrap;
        }

        .btn:hover {
            background: var(--surface);
            transform: scale(0.97);
        }

        .btn-primary {
            background: var(--accent);
            color: white;
            border: none;
        }
        .btn-primary:hover {
            background: #155a8a;
        }
        .btn-danger {
            color: var(--danger);
            border-color: rgba(201, 74, 74, 0.2);
        }
        .btn-danger:hover {
            background: var(--danger);
            color: white;
        }
        .btn-success {
            color: var(--success);
            border-color: rgba(47, 143, 75, 0.2);
        }
        .btn-success:hover {
            background: var(--success);
            color: white;
        }
        .btn-purple {
            color: var(--purple);
            border-color: rgba(124, 58, 237, 0.2);
        }
        .btn-purple:hover {
            background: var(--purple);
            color: white;
        }
        .btn-purple:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .sync-status {
            font-size: 0.6rem;
            padding: 3px 10px;
            border-radius: 40px;
            background: rgba(47, 143, 75, 0.08);
            border: 1px solid rgba(47, 143, 75, 0.15);
            color: var(--success);
            white-space: nowrap;
        }

        .sync-status.syncing {
            color: var(--warning);
            border-color: rgba(230, 180, 34, 0.2);
            background: rgba(230, 180, 34, 0.06);
        }
        .sync-status.error {
            color: var(--danger);
            border-color: rgba(201, 74, 74, 0.2);
            background: rgba(201, 74, 74, 0.06);
        }
        .sync-status.updating {
            color: var(--accent);
            border-color: rgba(31, 107, 158, 0.2);
            background: rgba(31, 107, 158, 0.06);
        }

        .user-badge {
            font-size: 0.65rem;
            padding: 3px 12px;
            border-radius: 40px;
            background: rgba(31, 107, 158, 0.08);
            border: 1px solid rgba(31, 107, 158, 0.15);
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: 0.2s;
            white-space: nowrap;
        }

        .user-badge:hover {
            background: rgba(31, 107, 158, 0.15);
        }

        .btn-settings {
            color: var(--text-secondary);
            border-color: var(--border);
            font-size: 1.1rem;
            padding: 4px 10px;
            line-height: 1;
        }
        .btn-settings:hover {
            background: var(--surface);
            transform: scale(0.97) rotate(30deg);
        }

        /* ===== ДАШБОРД ===== */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
            gap: 0.4rem;
            margin-bottom: 1rem;
            padding: 0.6rem 0.8rem;
            background: rgba(255, 255, 255, 0.04);
            border-radius: var(--radius);
            border: 1px solid var(--border);
        }

        .stat {
            text-align: center;
        }
        .stat .num {
            font-size: 1.3rem;
            font-weight: 700;
        }
        .stat .label {
            font-size: 0.45rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            opacity: 0.6;
        }
        .stat .num.critical {
            color: var(--danger);
        }
        .stat .num.done {
            color: var(--success);
        }
        .stat .num.waiting {
            color: #7a7a9a;
        }
        .stat .num.progress {
            color: var(--warning);
        }

        /* ===== ПРОГРЕСС ===== */
        .progress-bar {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 1rem;
            padding: 0.3rem 0.8rem;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 40px;
            border: 1px solid var(--border);
        }

        .progress-bar .track {
            flex: 1;
            height: 4px;
            background: rgba(0, 0, 0, 0.06);
            border-radius: 40px;
            overflow: hidden;
        }

        .progress-bar .fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--success), var(--accent));
            border-radius: 40px;
            transition: width 0.6s;
        }

        .progress-bar .pct {
            font-weight: 700;
            font-size: 0.7rem;
            min-width: 34px;
            text-align: right;
        }

        .progress-bar .label {
            font-size: 0.65rem;
            color: var(--text-secondary);
            opacity: 0.6;
            white-space: nowrap;
        }

        /* ===== ДОБАВЛЕНИЕ ===== */
        .add-row {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
            padding: 0.4rem 0.6rem;
            border-radius: var(--radius);
            border: 1px dashed var(--border);
            background: rgba(255, 255, 255, 0.02);
        }

        .add-row input,
        .add-row select {
            flex: 1;
            min-width: 80px;
            padding: 4px 10px;
            border-radius: 30px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.05);
            font-size: 0.7rem;
            color: var(--text);
            font-family: var(--font);
        }

        .add-row input:focus,
        .add-row select:focus {
            outline: none;
            border-color: var(--accent);
        }

        .add-row input::placeholder {
            color: var(--text-secondary);
            opacity: 0.4;
        }

        /* ===== ТАБЛИЦА ===== */
        .table-wrap {
            overflow-x: auto;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.03);
            padding: 0.1rem;
            margin-bottom: 1rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.75rem;
            min-width: 650px;
        }

        th {
            text-align: left;
            padding: 0.5rem 0.4rem 0.3rem 0.6rem;
            font-size: 0.55rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border);
            opacity: 0.6;
        }

        td {
            padding: 0.3rem 0.4rem 0.3rem 0.6rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.02);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }
        tr:hover td {
            background: rgba(31, 107, 158, 0.03);
        }

        .col-id {
            width: 32px;
            text-align: center;
            font-weight: 600;
            color: var(--text-secondary);
            opacity: 0.3;
            cursor: grab;
            font-size: 0.7rem;
        }

        .col-id::after {
            content: '⠿';
            opacity: 0.2;
            margin-left: 3px;
        }

        .col-task {
            width: 25%;
        }
        .col-owner {
            width: 10%;
        }
        .col-deadline {
            width: 11%;
        }
        .col-status {
            width: 13%;
        }
        .col-comment {
            width: 20%;
        }
        .col-actions {
            width: 70px;
            text-align: center;
        }

        /* ===== РЕДАКТИРУЕМЫЕ ПОЛЯ ===== */
        .editable {
            background: transparent;
            border: none;
            border-bottom: 1px dashed var(--border);
            padding: 2px 3px;
            font-family: var(--font);
            font-size: 0.75rem;
            color: var(--text);
            width: 100%;
            transition: 0.2s;
        }

        .editable:focus {
            outline: none;
            border-bottom-color: var(--accent);
            background: rgba(255, 255, 255, 0.05);
        }

        .editable-task {
            font-weight: 500;
            min-height: 1.6rem;
            resize: vertical;
            overflow: hidden;
            line-height: 1.3;
        }

        .editable-comment {
            font-size: 0.65rem;
            min-height: 1.4rem;
            resize: vertical;
            overflow: hidden;
            line-height: 1.2;
            color: var(--text-secondary);
            font-style: italic;
        }

        /* ===== СТАТУС ===== */
        .status-select {
            padding: 2px 6px;
            border-radius: 30px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.05);
            font-size: 0.65rem;
            color: var(--text);
            cursor: pointer;
            width: 100%;
            max-width: 100px;
            font-family: var(--font);
        }

        .status-select.status-plan {
            border-color: #8bb3d0;
            background: rgba(200, 220, 240, 0.08);
        }
        .status-select.status-progress {
            border-color: #e6b422;
            background: rgba(255, 225, 140, 0.08);
        }
        .status-select.status-critical {
            border-color: var(--danger);
            background: rgba(255, 180, 180, 0.06);
        }
        .status-select.status-done {
            border-color: var(--success);
            background: rgba(150, 210, 160, 0.06);
        }
        .status-select.status-waiting {
            border-color: #7a7a9a;
            background: rgba(190, 190, 210, 0.04);
        }

        /* ===== КНОПКА УДАЛЕНИЯ ===== */
        .btn-del {
            background: transparent;
            border: none;
            color: var(--danger);
            opacity: 0.3;
            cursor: pointer;
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 30px;
            transition: 0.2s;
        }

        .btn-del:hover {
            opacity: 1;
            background: rgba(201, 74, 74, 0.08);
        }

        /* ===== ТУЛТИП ===== */
        .task-cell {
            position: relative;
            cursor: help;
        }

        .task-cell .tooltip {
            visibility: hidden;
            opacity: 0;
            position: absolute;
            bottom: 130%;
            left: 0;
            width: 280px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 8px 12px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
            font-size: 0.65rem;
            line-height: 1.4;
            transition: 0.2s;
            z-index: 100;
            pointer-events: none;
            backdrop-filter: blur(8px);
        }

        .task-cell:hover .tooltip {
            visibility: visible;
            opacity: 1;
        }

        .task-cell .tooltip .tt-task {
            font-weight: 600;
            font-size: 0.75rem;
            margin-bottom: 3px;
        }

        .task-cell .tooltip .tt-meta {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            color: var(--text-secondary);
            font-size: 0.55rem;
            opacity: 0.7;
        }

        .task-cell .tooltip .tt-meta span {
            display: flex;
            align-items: center;
            gap: 3px;
        }

        /* ===== ИСТОРИЯ ===== */
        .history-section {
            margin-top: 1rem;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.02);
            overflow: hidden;
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 1rem;
            cursor: pointer;
            user-select: none;
            transition: background 0.2s;
            background: rgba(255, 255, 255, 0.02);
        }

        .history-header:hover {
            background: rgba(31, 107, 158, 0.04);
        }

        .history-header .history-title {
            font-weight: 600;
            font-size: 0.75rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .history-header .history-title i {
            color: var(--accent);
        }

        .history-header .history-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            opacity: 0.3;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 30px;
            transition: all 0.3s;
            font-size: 0.7rem;
        }

        .history-header .history-toggle:hover {
            opacity: 0.8;
            background: rgba(255, 255, 255, 0.05);
        }

        .history-header .history-toggle.collapsed {
            transform: rotate(-90deg);
        }

        .history-content {
            padding: 0 1rem 1rem 1rem;
            transition: all 0.3s ease;
            overflow: hidden;
            max-height: 350px;
            overflow-y: auto;
        }

        .history-content.collapsed {
            display: none;
        }

        .history-content .history-empty {
            text-align: center;
            padding: 1rem;
            color: var(--text-secondary);
            opacity: 0.4;
            font-size: 0.75rem;
        }

        .history-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.02);
            font-size: 0.68rem;
            color: var(--text-secondary);
        }

        .history-item .history-time {
            font-weight: 500;
            color: var(--text);
            opacity: 0.5;
            min-width: 85px;
            font-size: 0.6rem;
        }

        .history-item .history-user {
            font-weight: 600;
            color: var(--accent);
            min-width: 70px;
        }

        .history-item .history-action {
            flex: 1;
            opacity: 0.8;
        }

        .history-item .history-action .from-status {
            color: var(--danger);
            font-weight: 500;
        }

        .history-item .history-action .to-status {
            color: var(--success);
            font-weight: 500;
        }

        .history-item .history-action .changed-field {
            color: var(--accent);
            font-weight: 500;
        }

        .history-item .history-task-id {
            font-weight: 600;
            color: var(--text);
            opacity: 0.4;
            font-size: 0.6rem;
            min-width: 30px;
        }

        /* ===== РИСКИ ===== */
        .risks {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.6rem;
            margin-top: 1rem;
        }

        .risk {
            padding: 0.6rem 0.8rem;
            border-radius: var(--radius);
            border-left: 4px solid #b0c8dd;
            background: rgba(255, 255, 255, 0.03);
            transition: all 0.3s ease;
        }

        .risk.critical {
            border-left-color: var(--danger);
            background: rgba(255, 220, 220, 0.04);
        }
        .risk.sync {
            border-left-color: var(--warning);
            background: rgba(255, 240, 180, 0.03);
        }
        .risk.training {
            border-left-color: var(--success);
            background: rgba(180, 235, 190, 0.03);
        }

        .risk .title {
            font-weight: 700;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 3px;
        }

        .risk .desc {
            font-size: 0.68rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .risk .desc strong {
            color: var(--text);
        }
        .risk .desc .hl {
            color: var(--danger);
            font-weight: 600;
        }

        .risk .footer {
            font-size: 0.55rem;
            color: var(--text-secondary);
            opacity: 0.5;
            margin-top: 4px;
        }

        /* ===== ФУТЕР ===== */
        .footer {
            margin-top: 1rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.4rem;
            font-size: 0.6rem;
            color: var(--text-secondary);
            opacity: 0.5;
        }

        .legend {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .legend .dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 20px;
            margin-right: 3px;
        }

        /* ===== ЗАГРУЗЧИК ===== */
        .loader {
            display: flex;
            justify-content: center;
            padding: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.8rem;
            gap: 8px;
            align-items: center;
        }

        .loader .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid var(--border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            100% {
                transform: rotate(360deg);
            }
        }

        .hidden {
            display: none !important;
        }

        /* ===== DRAG ===== */
        tr.dragging {
            opacity: 0.4;
        }
        tr.drag-over td {
            border-top: 2px solid var(--accent);
        }

        /* ===== МОДАЛЬНЫЕ ОКНА ===== */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(6px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            animation: fadeIn 0.25s ease-out;
        }

        .modal-overlay.hidden {
            display: none;
        }

        .modal {
            background: var(--surface);
            border-radius: 20px;
            padding: 1.8rem 2rem 1.5rem;
            max-width: 420px;
            width: 92%;
            border: 1px solid var(--border);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            animation: modalSlide 0.3s ease-out;
        }

        .modal .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.2rem;
        }

        .modal .modal-header h2 {
            font-size: 1.1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal .modal-header .close-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            opacity: 0.3;
            cursor: pointer;
            font-size: 1.3rem;
            padding: 4px 8px;
            border-radius: 30px;
            transition: 0.2s;
            line-height: 1;
        }

        .modal .modal-header .close-btn:hover {
            opacity: 0.8;
            background: rgba(255, 255, 255, 0.05);
        }

        .modal .form-group {
            margin-bottom: 0.9rem;
        }

        .modal .form-group label {
            display: block;
            font-size: 0.7rem;
            font-weight: 600;
