                ta.value = t.task;
                ta.rows = 1;
                let oldTask = t.task;
                ta.addEventListener('input', function() {
                    t.task = this.value;
                    autoResize(this);
                    updateDashboard();
                });
                ta.addEventListener('blur', function() {
                    const newTask = t.task;
                    if (newTask !== oldTask && oldTask !== undefined) {
                        addHistoryEntry(t.id, t.task, 'task', oldTask, newTask);
                        oldTask = newTask;
                        scheduleSaveTasks();
                    }
                });
                requestAnimationFrame(() => autoResize(ta));

                const tip = document.createElement('div');
                tip.className = 'tooltip';
                tip.innerHTML = `
                    <div class="tt-task">${t.task}</div>
                    <div class="tt-meta">
                        <span>👤 ${t.owner || '—'}</span>
                        <span>📅 ${formatDate(t.deadline) || 'не указан'}</span>
                        <span>🏷️ ${t.status}</span>
                        <span>#️⃣ ${t.id}</span>
                        ${t.comment ? `<span>💬 ${t.comment.substring(0, 20)}${t.comment.length > 20 ? '…' : ''}</span>` : ''}
                    </div>
                `;
                tdTask.appendChild(ta);
                tdTask.appendChild(tip);

                const tdOwner = document.createElement('td');
                tdOwner.className = 'col-owner';
                const inpOwner = document.createElement('input');
                inpOwner.className = 'editable';
                inpOwner.value = t.owner;
                inpOwner.placeholder = '—';
                let oldOwner = t.owner;
                inpOwner.addEventListener('change', function() {
                    const newOwner = this.value;
                    if (newOwner !== oldOwner) {
                        addHistoryEntry(t.id, t.task, 'owner', oldOwner, newOwner);
                        t.owner = newOwner;
                        oldOwner = newOwner;
                        updateDashboard();
                        scheduleSaveTasks();
                    }
                });
                tdOwner.appendChild(inpOwner);

                const tdDeadline = document.createElement('td');
                tdDeadline.className = 'col-deadline';
                const wrap = document.createElement('div');
                wrap.style.cssText = 'display:flex;align-items:center;gap:3px;';
                const dateInput = document.createElement('input');
                dateInput.type = 'date';
                dateInput.className = 'editable';
                dateInput.value = t.deadline || '';
                dateInput.style.cssText = 'flex:1;min-width:50px;';
                let oldDeadline = t.deadline;
                dateInput.addEventListener('change', function() {
                    const newDeadline = this.value;
                    if (newDeadline !== oldDeadline) {
                        addHistoryEntry(t.id, t.task, 'deadline', oldDeadline, newDeadline);
                        t.deadline = newDeadline;
                        oldDeadline = newDeadline;
                        updateDashboard();
                        scheduleSaveTasks();
                    }
                });
                const calBtn = document.createElement('button');
                calBtn.textContent = '📅';
                calBtn.style.cssText =
                    'background:transparent;border:none;cursor:pointer;opacity:0.4;padding:2px 3px;font-size:0.7rem;';
                calBtn.onclick = () => dateInput.showPicker ? dateInput.showPicker() : dateInput.click();
                wrap.appendChild(dateInput);
                wrap.appendChild(calBtn);
                tdDeadline.appendChild(wrap);

                const tdStatus = document.createElement('td');
                tdStatus.className = 'col-status';
                const sel = document.createElement('select');
                sel.className = 'status-select';
                const statuses = ['план', 'в работе', 'критично', 'готово', 'ожидание'];
                statuses.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s;
                    opt.textContent = s.charAt(0).toUpperCase() + s.slice(1);
                    if (s === t.status) opt.selected = true;
                    sel.appendChild(opt);
                });
                sel.className += ' ' + getStatusClass(t.status);

                let oldStatus = t.status;

                sel.addEventListener('change', function() {
                    const newStatus = this.value;
                    if (newStatus !== oldStatus) {
                        addHistoryEntry(t.id, t.task, 'status', oldStatus, newStatus);
                        t.status = newStatus;
                        oldStatus = newStatus;
                        this.className = 'status-select ' + getStatusClass(t.status);
                        updateDashboard();
                        scheduleSaveTasks();
                    }
                });
                tdStatus.appendChild(sel);

                const tdComment = document.createElement('td');
                tdComment.className = 'col-comment';
                const commentArea = document.createElement('textarea');
                commentArea.className = 'editable editable-comment';
                commentArea.value = t.comment || '';
                commentArea.placeholder = 'Добавить комментарий...';
                commentArea.rows = 1;
                let oldComment = t.comment || '';

                function saveComment(newComment) {
                    if (newComment !== oldComment) {
                        addHistoryEntry(t.id, t.task, 'comment', oldComment, newComment);
                        t.comment = newComment;
                        oldComment = newComment;
                        scheduleSaveTasks();
                    }
                }

                commentArea.addEventListener('input', function() {
                    t.comment = this.value;
                    autoResize(this);
                    updateDashboard();
                });

                commentArea.addEventListener('blur', function() {
                    const newComment = this.value;
                    if (newComment !== oldComment) {
                        saveComment(newComment);
                    }
                });

                commentArea.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        this.blur();
                    }
                });

                requestAnimationFrame(() => autoResize(commentArea));
                tdComment.appendChild(commentArea);

                const tdActions = document.createElement('td');
                tdActions.className = 'col-actions';
                const delBtn = document.createElement('button');
                delBtn.className = 'btn-del';
                delBtn.textContent = '🗑️';
                delBtn.onclick = () => deleteTask(t.id);
                tdActions.appendChild(delBtn);

                tr.appendChild(tdId);
                tr.appendChild(tdTask);
                tr.appendChild(tdOwner);
                tr.appendChild(tdDeadline);
                tr.appendChild(tdStatus);
                tr.appendChild(tdComment);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
            updateDashboard();
            updateRiskPoints();
        }

        // --- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ---
        function getStatusClass(s) {
            const map = {
                'план': 'status-plan',
                'в работе': 'status-progress',
                'критично': 'status-critical',
                'готово': 'status-done',
                'ожидание': 'status-waiting'
            };
            return map[s] || '';
        }

        function formatDate(d) {
            if (!d) return '';
            const parts = d.split('-');
            if (parts.length === 3) return `${parts[2]}.${parts[1]}.${parts[0]}`;
            return d;
        }

        function autoResize(el) {
            el.style.height = 'auto';
            el.style.height = el.scrollHeight + 'px';
        }

        function updateDashboard() {
            const stats = { total: tasks.length, critical: 0, progress: 0, done: 0, waiting: 0, plan: 0 };
            tasks.forEach(t => {
                if (t.status === 'критично') stats.critical++;
                else if (t.status === 'в работе') stats.progress++;
                else if (t.status === 'готово') stats.done++;
                else if (t.status === 'ожидание') stats.waiting++;
                else if (t.status === 'план') stats.plan++;
            });
            document.getElementById('total').textContent = stats.total;
            document.getElementById('critical').textContent = stats.critical;
            document.getElementById('progress').textContent = stats.progress;
            document.getElementById('done').textContent = stats.done;
            document.getElementById('waiting').textContent = stats.waiting;
            document.getElementById('plan').textContent = stats.plan;

            const pct = stats.total ? Math.round((stats.done / stats.total) * 100) : 0;
            document.getElementById('progressFill').style.width = pct + '%';
            document.getElementById('progressText').textContent = pct + '%';
        }

        function setSyncStatus(type, msg) {
            const el = document.getElementById('syncStatus');
            el.className = 'sync-status';
            if (type === 'syncing') el.classList.add('syncing');
            if (type === 'error') el.classList.add('error');
            if (type === 'updating') el.classList.add('updating');
            const icons = {
                'synced': '☁️',
                'syncing': '⏳',
                'error': '❌',
                'updating': '🔄'
            };
            el.innerHTML = (icons[type] || icons.synced) + ' ' + msg;
        }

        function scheduleSaveTasks() {
            if (saveTimer) clearTimeout(saveTimer);
            saveTimer = setTimeout(async () => {
                await saveTasksOnly(tasks);
                saveTimer = null;
            }, 500);
        }

        function scheduleSave() {
            if (saveTimer) clearTimeout(saveTimer);
            saveTimer = setTimeout(async () => {
                await saveTasksOnly(tasks);
                saveTimer = null;
            }, 500);
        }

        // --- CRUD ---
        function addTask() {
            const task = document.getElementById('newTask').value.trim();
            const owner = document.getElementById('newOwner').value.trim() || 'Не назначен';
            const deadline = document.getElementById('newDeadline').value || '';
            const status = document.getElementById('newStatus').value;
            if (!task) { alert('Введите название задачи'); return; }
            const maxId = tasks.reduce((max, t) => Math.max(max, t.id), 0);
            const newTask = { id: maxId + 1, task, owner, deadline, status, comment: '' };
            tasks.push(newTask);
            document.getElementById('newTask').value = '';
            document.getElementById('newOwner').value = '';
            document.getElementById('newDeadline').value = '';
            renderTable();

            addHistoryEntry(newTask.id, task, 'add', '', task);
            scheduleSaveTasks();
        }

        function deleteTask(id) {
            if (!confirm(`Удалить задачу №${id}?`)) return;
            const task = tasks.find(t => t.id === id);
            if (task) {
                addHistoryEntry(id, task.task, 'delete', task.task, '');
            }
            tasks = tasks.filter(t => t.id !== id);
            renderTable();
            scheduleSaveTasks();
        }

        // --- DRAG & DROP ---
        let dragId = null;

        function onDragStart(e) {
            const row = e.target.closest('tr');
            if (!row) return;
            dragId = parseInt(row.dataset.id);
            row.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
        }

        function onDragEnd(e) {
            document.querySelectorAll('.dragging').forEach(el => el.classList.remove('dragging'));
            document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
        }

        function onDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const row = e.target.closest('tr');
            if (!row) return;
            document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
            row.classList.add('drag-over');
        }

        function onDragLeave(e) {
            const row = e.target.closest('tr');
            if (row) row.classList.remove('drag-over');
        }

        function onDrop(e) {
            e.preventDefault();
            const targetRow = e.target.closest('tr');
            if (!targetRow) return;
            document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
            const targetId = parseInt(targetRow.dataset.id);
            if (dragId === null || dragId === targetId) return;
            const fromIdx = tasks.findIndex(t => t.id === dragId);
            const toIdx = tasks.findIndex(t => t.id === targetId);
            if (fromIdx === -1 || toIdx === -1) return;
            const [moved] = tasks.splice(fromIdx, 1);
            tasks.splice(toIdx, 0, moved);
            tasks.forEach((t, i) => t.id = i + 1);
            renderTable();
            scheduleSaveTasks();
            dragId = null;
        }

        // --- ОБНОВЛЕНИЕ РИСКОВ В ТЕКСТЕ ---
        function updateRiskPoints() {
            const findPoint = (taskId) => {
                const index = tasks.findIndex(t => t.id === taskId);
                return index !== -1 ? index + 1 : '?';
            };

            const findTaskByKeyword = (keyword) => {
                const found = tasks.find(t => t.task.toLowerCase().includes(keyword.toLowerCase()));
                return found ? found.id : null;
            };

            const task4 = findTaskByKeyword('Заблокировать загрузку документов');
            const task1 = findTaskByKeyword('Доделать доработки после приемки');
            const task2 = findTaskByKeyword('Настроить права доступа');
            const task3 = findTaskByKeyword('Разработка инструкции');
            const task12 = findTaskByKeyword('Предоставление доступа сетевой связанности');
            const task19 = findTaskByKeyword('Обучение пользователей');

            const task12Index = tasks.findIndex(t => t.id === task12);
            const after12 = tasks.slice(task12Index + 1);
            const task13 = after12.length > 0 ? after12[0]?.id : null;
            const task18 = after12.length > 5 ? after12[5]?.id : after12[after12.length - 1]?.id;

            const p1 = task1 ? findPoint(task1) : '?';
            const p2 = task2 ? findPoint(task2) : '?';
            const p3 = task3 ? findPoint(task3) : '?';
            const p4 = task4 ? findPoint(task4) : '?';
            const p12 = task12 ? findPoint(task12) : '?';
            const p13 = task13 ? findPoint(task13) : '?';
            const p18 = task18 ? findPoint(task18) : '?';
            const p19 = task19 ? findPoint(task19) : '?';

            const elements = {
                'riskPoint1': p1,
                'riskPoint1_2': p1,
                'riskPoint2': p2,
                'riskPoint2_2': p2,
                'riskPoint3': p3,
                'riskPoint3_2': p3,
                'riskPoint4': p4,
                'riskPoint12': p12,
                'riskPoint13': p13,
                'riskPoint13_2': p13,
                'riskPoint18': p18,
                'riskPoint18_2': p18,
                'riskPoint19': p19
            };

            Object.keys(elements).forEach(id => {
                const el = document.getElementById(id);
                if (el) el.textContent = elements[id];
            });
        }

        // --- ЭКСПОРТ ---
        function exportData() {
            const blob = new Blob([document.documentElement.outerHTML], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Дорожная_карта_ОЗП_2.0_${new Date().toISOString().slice(0, 10)}.html`;
            a.click();
            URL.revokeObjectURL(url);
        }

        // --- СБРОС ---
        function resetData() {
            if (!confirm('Сбросить все изменения к исходным данным?')) return;
            tasks = getDefaultTasks();
            historyData = [];
            risks = [];
            roadmapTitle = '🚀 Дорожная карта ОЗП 2.0';
            titleDisplay.innerHTML = `<span>${roadmapTitle}</span>`;
            titleInput.value = roadmapTitle;
            localStorage.setItem('ozp_title', roadmapTitle);
            renderTable();
            renderHistory();
            renderRisks(risks);
            scheduleSave();
        }

        // --- ТЕМА ---
        function toggleTheme() {
            const dark = document.documentElement.getAttribute('data-theme') === 'dark';
            document.documentElement.setAttribute('data-theme', dark ? '' : 'dark');
            document.getElementById('themeBtn').textContent = dark ? '🌙' : '☀️';
            localStorage.setItem('theme', dark ? 'light' : 'dark');
        }

        // --- ЗАПУСК ---
        document.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('theme');
            if (saved === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                document.getElementById('themeBtn').textContent = '☀️';
            }

            init();

            document.getElementById('newTask').addEventListener('keydown', e => { if (e.key === 'Enter') addTask(); });
            document.getElementById('newOwner').addEventListener('keydown', e => { if (e.key === 'Enter') addTask(); });
            document.getElementById('newDeadline').addEventListener('keydown', e => { if (e.key === 'Enter') addTask(); });
        });
    </script>
</body>
