        async function generateRisksWithAI() {
            const btn = document.getElementById('generateRisksBtn');
            if (!btn) return;
            btn.disabled = true;
            btn.innerHTML = '⏳ Генерация...';

            try {
                if (tasks.length === 0) {
                    alert('⚠️ Добавьте хотя бы одну задачу.');
                    btn.disabled = false;
                    btn.innerHTML = '🤖 Сгенерировать риски';
                    return;
                }

                const proxyKey = appSettings.proxyKey || PROXY_API_KEY;
                if (!proxyKey || proxyKey === '') {
                    alert('⚠️ Сначала настройте API-ключ ProxyAPI в настройках (⚙️)');
                    btn.disabled = false;
                    btn.innerHTML = '🤖 Сгенерировать риски';
                    openSettings();
                    return;
                }

                const tasksDescription = tasks.map((t, i) =>
                    `${i+1}. ${t.task} (статус: ${t.status || 'не указан'}, срок: ${t.deadline || 'не указан'}, ответственный: ${t.owner || 'не назначен'})`
                ).join('\n');

                const prompt = `
                Ты эксперт по управлению проектами. Проанализируй следующие задачи дорожной карты и выдели 3 главных риска.

                Задачи:
                ${tasksDescription}

                Выдели:
                1. Критический риск (блокер) — что может полностью остановить проект
                2. Риск по срокам — что может привести к задержкам
                3. Риск по качеству/обучению — что может снизить эффективность

                Для каждого риска напиши название и описание с рекомендацией.
                Ответ верни строго в формате JSON (без лишнего текста):
                [
                  {
                    "title": "Название риска",
                    "description": "Описание риска и что делать",
                    "icon": "⚠️"
                  }
                ]
                `;

                const requestBody = {
                    model: appSettings.model || 'gpt-4o-mini',
                    messages: [
                        { role: 'system', content: 'Ты эксперт по управлению проектами.' },
                        { role: 'user', content: prompt }
                    ],
                    temperature: 0.7,
                    max_tokens: 800
                };

                const isLocal = window.location.protocol === 'file:';
                const isGitHubPages = window.location.hostname.includes('github.io');

                let response = null;
                let lastError = null;

                // Если на GitHub Pages или локально — пробуем прокси
                if (isLocal || isGitHubPages) {
                    const targetUrl = 'https://proxyapi.ru/api/v1/chat/completions';

                    for (const proxy of CORS_PROXIES) {
                        try {
                            const proxyUrl = proxy + encodeURIComponent(targetUrl);
                            console.log(`🔄 Пробую прокси: ${proxy}`);

                            const controller = new AbortController();
                            const timeoutId = setTimeout(() => controller.abort(), 15000);

                            response = await fetch(proxyUrl, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': `Bearer ${proxyKey}`
                                },
                                body: JSON.stringify(requestBody),
                                signal: controller.signal
                            });

                            clearTimeout(timeoutId);

                            if (response.ok) {
                                console.log(`✅ Прокси работает: ${proxy}`);
                                break;
                            } else {
                                console.warn(`⚠️ Прокси ${proxy} вернул ошибку: ${response.status}`);
                                lastError = new Error(`HTTP ${response.status}`);
                            }
                        } catch (e) {
                            console.warn(`❌ Прокси ${proxy} не работает:`, e.message);
                            lastError = e;
                        }
                    }

                    if (!response || !response.ok) {
                        throw lastError || new Error('Все прокси недоступны');
                    }
                } else {
                    // Прямой запрос (если на сервере с поддержкой CORS)
                    response = await fetch('https://proxyapi.ru/api/v1/chat/completions', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${proxyKey}`
                        },
                        body: JSON.stringify(requestBody)
                    });
                }

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(`HTTP ${response.status}: ${errorData.error?.message || 'Неизвестная ошибка'}`);
                }

                const data = await response.json();
                let aiText = data.choices?.[0]?.message?.content || '';

                const jsonMatch = aiText.match(/\[[\s\S]*\]/);
                if (jsonMatch) aiText = jsonMatch[0];

                const parsedRisks = JSON.parse(aiText);

                if (!Array.isArray(parsedRisks)) {
                    throw new Error('Нейросеть вернула не массив');
                }

                const formattedRisks = parsedRisks.map((r, idx) => ({
                    title: r.title || `Риск ${idx + 1}`,
                    description: r.description || r.recommendation || 'Описание отсутствует',
                    icon: r.icon || ['⚠️', '🕐', '🎓'][idx % 3]
                }));

                risks = formattedRisks;
                renderRisks(risks);
                scheduleSave();

                setSyncStatus('synced', '✅ Риски сгенерированы!');
                setTimeout(() => setSyncStatus('synced', 'Синхронизировано'), 3000);

            } catch (error) {
                console.error('Ошибка генерации рисков:', error);
                let userMessage = '❌ Не удалось сгенерировать риски. ';

                if (error.message.includes('HTTP 403') || error.message.includes('HTTP 401')) {
                    userMessage += 'Неверный API-ключ. Проверьте настройки (⚙️).';
                } else if (error.message.includes('HTTP 429')) {
                    userMessage += 'Слишком много запросов. Подождите минуту.';
                } else if (error.message.includes('JSON')) {
                    userMessage += 'Некорректный формат ответа. Попробуйте ещё раз.';
                } else if (error.message.includes('Failed to fetch') || error.message.includes('CORS') || error.message.includes('ERR_FAILED') || error.message.includes('ERR_CONNECTION')) {
                    userMessage += 'Проблема с подключением.\n\n' +
                        'Попробуйте:\n' +
                        '1. Запустить через локальный сервер (Live Server)\n' +
                        '2. Загрузить на GitHub Pages\n' +
                        '3. Проверить интернет-соединение\n' +
                        '4. Использовать VPN';
                } else {
                    userMessage += error.message || 'Попробуйте позже.';
                }

                alert(userMessage);
                setSyncStatus('error', 'Ошибка генерации');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '🤖 Сгенерировать риски';
            }
        }

