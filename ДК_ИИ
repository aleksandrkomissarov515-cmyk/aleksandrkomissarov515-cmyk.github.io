        .modal .key-status .dot.green {
            background: var(--success);
        }
        .modal .key-status .dot.gray {
            background: #aaa;
        }

        .modal .modal-actions {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
            margin-top: 1.2rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
