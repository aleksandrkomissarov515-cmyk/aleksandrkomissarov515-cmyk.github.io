                const newDisplay = newValue ? `«${newValue.substring(0, 25)}${newValue.length > 25 ? '…' : ''}»` : '—';
                actionText = `изменил название: <span class="from-status">${oldDisplay}</span> → <span class="to-status">${newDisplay}</span>`;
            } else if (field === 'owner') {
                actionText =
                    `изменил ответственного: <span class="from-status">${oldValue || '—'}</span> → <span class="to-status">${newValue || '—'}</span>`;
            } else if (field === 'deadline') {
                const oldDisplay = oldValue ? formatDate(oldValue) : 'не указан';
                const newDisplay = newValue ? formatDate(newValue) : 'не указан';
                actionText =
                    `изменил срок: <span class="from-status">${oldDisplay}</span> → <span class="to-status">${newDisplay}</span>`;
            } else if (field === 'comment') {
                const oldDisplay = oldValue ? `«${oldValue.substring(0, 25)}${oldValue.length > 25 ? '…' : ''}»` : '—';
                const newDisplay = newValue ? `«${newValue.substring(0, 25)}${newValue.length > 25 ? '…' : ''}»` : '—';
                actionText =
                    `изменил комментарий: <span class="from-status">${oldDisplay}</span> → <span class="to-status">${newDisplay}</span>`;
            } else if (field === 'add') {
                actionText = `➕ <strong>добавил</strong> задачу «${newValue}»`;
            } else if (field === 'delete') {
                actionText = `🗑️ <strong>удалил</strong> задачу «${oldValue}»`;
            } else if (field === 'title') {
                actionText =
                    `✏️ <strong>изменил название</strong> дорожной карты: «${oldValue}» → «${newValue}»`;
            } else {
                actionText = `изменил: ${oldValue} → ${newValue}`;
            }

            const entry = {
                time: timeStr,
                user: currentUser,
                taskId: taskId || 0,
                taskName: taskName || '',
                action: actionText,
                field: field,
                timestamp: now.getTime()
            };

            historyData.unshift(entry);
            if (historyData.length > 100) {
                historyData = historyData.slice(0, 100);
            }

            renderHistory();
            saveHistoryOnly(historyData);
        }

