        async function loadFromCloud() {
            try {
                const resp = await fetch('https://jsonbox.ru/api.php?action=get', {
                    headers: { 'X-API-Key': API_KEY }
                });
                const data = await resp.json();

                if (data && data.data) {
                    if (data.data.tasks) tasks = data.data.tasks;
                    if (data.data.history) {
                        historyData = data.data.history;
                        renderHistory();
                    } else {
                        historyData = [];
                        renderHistory();
                        await saveHistoryOnly([]);
                    }
                    if (data.data.title) {
                        roadmapTitle = data.data.title;
                        titleDisplay.innerHTML = `<span>${roadmapTitle}</span>`;
                        localStorage.setItem('ozp_title', roadmapTitle);
                    }
                    if (data.data.risks) {
                        risks = data.data.risks;
                        renderRisks(risks);
                    }
                    return true;
                }
                return false;
            } catch (e) {
                console.error('❌ Ошибка загрузки:', e);
                return false;
            }
        }

        async function saveTasksOnly(data) {
            if (isSaving) return;
            isSaving = true;
            try {
                setSyncStatus('syncing', 'Сохранение...');

                const payload = {
                    data_update: {
                        title: roadmapTitle,
                        tasks: data || tasks,
                        history: historyData,
                        risks: risks
                    }
                };

                const resp = await fetch('https://jsonbox.ru/api.php?action=update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-API-Key': API_KEY
                    },
                    body: JSON.stringify(payload)
                });

                const result = await resp.json();
                if (result.success === true) {
                    setSyncStatus('synced', 'Синхронизировано');
                    return true;
                } else {
                    const storeResp = await fetch('https://jsonbox.ru/api.php?action=store', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-API-Key': API_KEY
                        },
                        body: JSON.stringify({
                            data: {
                                title: roadmapTitle,
                                tasks: data || tasks,
                                history: historyData,
                                risks: risks
                            }
                        })
                    });
                    const storeResult = await storeResp.json();
                    if (storeResult.success === true) {
                        setSyncStatus('synced', 'Синхронизировано');
                        return true;
                    } else {
                        setSyncStatus('error', 'Ошибка сохранения');
                        return false;
                    }
                }
            } catch (e) {
                console.error('❌ Ошибка сохранения:', e);
                setSyncStatus('error', 'Ошибка сохранения');
                return false;
            } finally {
                isSaving = false;
            }
        }

        // --- АВТООБНОВЛЕНИЕ ---
        async function checkForUpdates() {
            if (isUpdating) return;
            isUpdating = true;

            try {
                const resp = await fetch('https://jsonbox.ru/api.php?action=get', {
                    headers: { 'X-API-Key': API_KEY }
                });
                const data = await resp.json();

                if (data && data.data) {
                    let hasChanges = false;

                    if (data.data.tasks) {
                        const cloudTasks = data.data.tasks;
                        if (JSON.stringify(cloudTasks) !== JSON.stringify(tasks)) {
                            tasks = cloudTasks;
                            hasChanges = true;
                        }
                    }

                    if (data.data.history) {
                        const cloudHistory = data.data.history;
                        if (JSON.stringify(cloudHistory) !== JSON.stringify(historyData)) {
                            historyData = cloudHistory;
                            renderHistory();
                            hasChanges = true;
                        }
                    }

                    if (data.data.risks) {
                        const cloudRisks = data.data.risks;
                        if (JSON.stringify(cloudRisks) !== JSON.stringify(risks)) {
                            risks = cloudRisks;
                            renderRisks(risks);
                            hasChanges = true;
                        }
                    }

                    if (data.data.title && data.data.title !== roadmapTitle) {
                        roadmapTitle = data.data.title;
                        titleDisplay.innerHTML = `<span>${roadmapTitle}</span>`;
                        localStorage.setItem('ozp_title', roadmapTitle);
                        hasChanges = true;
                    }

                    if (hasChanges) {
                        renderTable();
                        setSyncStatus('updating', '🔄 Обновлено');
                        setTimeout(() => setSyncStatus('synced', 'Синхронизировано'), 2000);
                    }
                }
            } catch (e) {
                console.warn('⚠️ Ошибка проверки обновлений:', e);
            } finally {
                isUpdating = false;
            }
        }

