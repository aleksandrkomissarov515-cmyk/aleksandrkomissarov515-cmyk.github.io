</head>
<body>
    <div class="container" id="app">
        <!-- ШАПКА -->
        <div class="header">
            <div class="header-left">
                <div class="title-wrapper">
                    <span class="title-display" id="titleDisplay"><span>🚀 Дорожная карта ОЗП 2.0</span></span>
                    <input type="text" class="title-input" id="titleInput" value="🚀 Дорожная карта ОЗП 2.0" />
                    <button class="title-edit-btn" id="titleEditBtn" aria-label="Редактировать название">
                        ✏️
                    </button>
                </div>
            </div>
            <div class="header-actions">
                <span class="user-badge" id="userBadge" onclick="showNameModal()">👤 <span id="userNameDisplay">Гость</span></span>
                <span class="sync-status" id="syncStatus">☁️ синхронизировано</span>
                <button class="btn btn-settings" id="settingsBtn" aria-label="Настройки">⚙️</button>
                <button class="btn btn-purple" id="generateRisksBtn" onclick="generateRisksWithAI()">🤖 Сгенерировать риски</button>
                <button class="btn btn-success" onclick="exportData()">⬇️ Скачать</button>
                <button class="btn" onclick="toggleTheme()" id="themeBtn">🌙</button>
                <button class="btn btn-danger" onclick="resetData()">↺ Сброс</button>
            </div>
        </div>

        <!-- МОДАЛЬНОЕ ОКНО НАСТРОЕК -->
        <div class="modal-overlay hidden" id="settingsModal">
            <div class="modal">
                <div class="modal-header">
                    <h2>⚙️ Настройки</h2>
                    <button class="close-btn" onclick="closeSettings()">✕</button>
                </div>

                <div class="form-group">
                    <label>🔑 API-ключ ProxyAPI (для ИИ)</label>
                    <div class="input-wrapper">
                        <input type="password" id="proxyKeyInput" placeholder="Введите ключ..." />
                        <button class="toggle-visibility" onclick="toggleVisibility('proxyKeyInput', this)">👁️</button>
                    </div>
                    <div class="key-status" id="proxyStatus">
                        <span class="dot gray"></span> <span>не настроен</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>🧠 Модель ИИ</label>
                    <select id="modelSelect">
                        <option value="gpt-4o-mini">GPT-4o-mini</option>
                        <option value="gpt-3.5-turbo">GPT-3.5-turbo</option>
                        <option value="deepseek-chat">DeepSeek Chat</option>
                        <option value="deepseek-reasoner">DeepSeek Reasoner</option>
                    </select>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-secondary" onclick="closeSettings()">Отмена</button>
                    <button class="btn btn-primary" onclick="saveSettings()">💾 Сохранить</button>
                </div>
            </div>
        </div>

        <!-- МОДАЛЬНОЕ ОКНО ДЛЯ ИМЕНИ -->
        <div class="modal-overlay hidden" id="nameModal">
            <div class="modal">
                <div class="modal-header">
                    <h2>👤 Ваше имя</h2>
                    <button class="close-btn" onclick="closeNameModal()">✕</button>
                </div>
                <p style="font-size:0.8rem;color:var(--text-secondary);opacity:0.7;margin-bottom:1rem;">Введите ваше имя, чтобы видеть, кто менял задачи.</p>
                <input type="text" id="userNameInput" placeholder="Ваше имя..." maxlength="30" style="width:100%;padding:8px 14px;border-radius:40px;border:1px solid var(--border);background:rgba(255,255,255,0.04);font-family:var(--font);font-size:0.9rem;color:var(--text);outline:none;" />
                <div class="modal-actions" style="margin-top:1rem;">
                    <button class="btn btn-primary" onclick="saveUserName()">✅ Сохранить</button>
                </div>
            </div>
        </div>

        <!-- ДАШБОРД -->
        <div class="dashboard" id="dashboard">
            <div class="stat"><div class="num" id="total">0</div><div class="label">Всего</div></div>
            <div class="stat"><div class="num critical" id="critical">0</div><div class="label">Критично</div></div>
            <div class="stat"><div class="num progress" id="progress">0</div><div class="label">В работе</div></div>
            <div class="stat"><div class="num done" id="done">0</div><div class="label">Готово</div></div>
            <div class="stat"><div class="num waiting" id="waiting">0</div><div class="label">Ожидание</div></div>
            <div class="stat"><div class="num" id="plan">0</div><div class="label">План</div></div>
        </div>

        <!-- ПРОГРЕСС -->
        <div class="progress-bar">
            <span class="label">📊 Прогресс</span>
            <div class="track"><div class="fill" id="progressFill"></div></div>
            <span class="pct" id="progressText">0%</span>
        </div>

        <!-- ДОБАВЛЕНИЕ -->
        <div class="add-row">
            <input type="text" id="newTask" placeholder="Название задачи..." />
            <input type="text" id="newOwner" placeholder="Ответственный..." />
            <input type="date" id="newDeadline" />
            <select id="newStatus">
                <option value="план">План</option>
                <option value="в работе">В работе</option>
                <option value="критично">Критично</option>
                <option value="готово">Готово</option>
                <option value="ожидание">Ожидание</option>
            </select>
            <button class="btn btn-primary" onclick="addTask()">➕ Добавить</button>
        </div>

        <!-- ТАБЛИЦА -->
        <div class="table-wrap">
            <div id="loader" class="loader">
                <span class="spinner"></span> Загрузка данных...
            </div>
            <table id="taskTable" class="hidden">
                <thead>
                    <tr>
                        <th class="col-id">#</th>
                        <th class="col-task">Задача</th>
                        <th class="col-owner">Ответственный</th>
                        <th class="col-deadline">Срок</th>
                        <th class="col-status">Статус</th>
                        <th class="col-comment">Комментарий</th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>

        <!-- ИСТОРИЯ -->
        <div class="history-section">
            <div class="history-header" onclick="toggleHistory()">
                <span class="history-title">📜 История изменений</span>
                <button class="history-toggle" id="historyToggle" aria-label="Свернуть/развернуть">▼</button>
            </div>
            <div class="history-content" id="historyContent">
                <div id="historyList"></div>
            </div>
        </div>

        <!-- РИСКИ -->
        <div class="risks" id="risksContainer">
            <!-- Риски загружаются динамически -->
        </div>

        <!-- ФУТЕР -->
        <div class="footer">
            <div class="legend">
                <span><span class="dot" style="background:#8bb3d0;"></span>план</span>
                <span><span class="dot" style="background:#e6b422;"></span>в работе</span>
                <span><span class="dot" style="background:var(--danger);"></span>критично</span>
                <span><span class="dot" style="background:var(--success);"></span>готово</span>
                <span><span class="dot" style="background:#7a7a9a;"></span>ожидание</span>
            </div>
            <div>🔄 автосохранение · 🔄 автообновление каждые 15 сек</div>
        </div>
    </div>

    <script>
        // ================================================================
        //  ⚙️  НАСТРОЙКИ
        // ================================================================
        const API_KEY = '5afb9a66d6f5afbb623f8b83eb3bea42';

        // Загружаем настройки из localStorage
        let appSettings = loadSettings();
        let PROXY_API_KEY = appSettings.proxyKey || '';
        let AI_MODEL = appSettings.model || 'gpt-4o-mini';

        function loadSettings() {
            try {
                const saved = localStorage.getItem('ozp_ai_settings');
                if (saved) {
                    const settings = JSON.parse(saved);
                    return settings;
                }
            } catch (e) { console.warn('Ошибка загрузки настроек:', e); }
            return { proxyKey: '', model: 'gpt-4o-mini' };
        }

        function saveSettingsToStorage(settings) {
            try {
                localStorage.setItem('ozp_ai_settings', JSON.stringify(settings));
            } catch (e) { console.warn('Ошибка сохранения настроек:', e); }
        }

        // --- УПРАВЛЕНИЕ МОДАЛЬНЫМИ ОКНАМИ ---
        function openSettings() {
            document.getElementById('settingsModal').classList.remove('hidden');
            document.getElementById('proxyKeyInput').value = appSettings.proxyKey || '';
            document.getElementById('modelSelect').value = appSettings.model || 'gpt-4o-mini';
            updateKeyStatus('proxyKeyInput', 'proxyStatus', appSettings.proxyKey);
        }

        function closeSettings() {
            document.getElementById('settingsModal').classList.add('hidden');
        }

        function saveSettings() {
            const proxyKey = document.getElementById('proxyKeyInput').value.trim();
            const model = document.getElementById('modelSelect').value;

            appSettings.proxyKey = proxyKey;
            appSettings.model = model;
            saveSettingsToStorage(appSettings);

            PROXY_API_KEY = proxyKey;
            AI_MODEL = model;

            updateKeyStatus('proxyKeyInput', 'proxyStatus', proxyKey);

            closeSettings();
            setSyncStatus('synced', '✅ Настройки сохранены!');
            setTimeout(() => setSyncStatus('synced', 'Синхронизировано'), 2000);
        }

        function updateKeyStatus(inputId, statusId, value) {
            const statusEl = document.getElementById(statusId);
            if (!statusEl) return;
            const dot = statusEl.querySelector('.dot');
            const text = statusEl.querySelector('span:last-child');
            if (value && value.length > 0) {
                dot.className = 'dot green';
                text.textContent = '✓ настроен';
            } else {
                dot.className = 'dot gray';
                text.textContent = 'не настроен';
            }
        }

        function toggleVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }

        // --- УПРАВЛЕНИЕ ИМЕНЕМ ---
        let currentUser = localStorage.getItem('ozp_user') || 'Гость';

        function showNameModal() {
            document.getElementById('nameModal').classList.remove('hidden');
            document.getElementById('userNameInput').value = currentUser === 'Гость' ? '' : currentUser;
            document.getElementById('userNameInput').focus();
        }

        function closeNameModal() {
            document.getElementById('nameModal').classList.add('hidden');
        }

        function saveUserName() {
            const name = document.getElementById('userNameInput').value.trim();
            if (name && name.length > 0) {
                currentUser = name;
                localStorage.setItem('ozp_user', name);
                document.getElementById('userNameDisplay').textContent = name;
                document.getElementById('nameModal').classList.add('hidden');
            } else {
                alert('Введите ваше имя');
            }
        }

        document.getElementById('nameModal').addEventListener('click', function(e) {
            if (e.target === this) closeNameModal();
        });

        document.getElementById('userNameInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') saveUserName();
        });

        // ================================================================
        //  🧠  ОСНОВНАЯ ЛОГИКА
        // ================================================================

        let tasks = [];
        let isSaving = false;
        let saveTimer = null;
        let historyData = [];
        let roadmapTitle = localStorage.getItem('ozp_title') || '🚀 Дорожная карта ОЗП 2.0';
        let isUpdating = false;
        let risks = [];

        // --- УПРАВЛЕНИЕ НАЗВАНИЕМ ---
        let isEditingTitle = false;
        const titleDisplay = document.getElementById('titleDisplay');
        const titleInput = document.getElementById('titleInput');
        const titleEditBtn = document.getElementById('titleEditBtn');

        function startTitleEdit() {
            isEditingTitle = true;
            titleDisplay.style.display = 'none';
            titleInput.style.display = 'block';
            titleInput.value = roadmapTitle;
            titleEditBtn.classList.add('active');
            titleInput.focus();
            titleInput.select();
        }

        function finishTitleEdit(save = true) {
            isEditingTitle = false;
            titleDisplay.style.display = 'block';
            titleInput.style.display = 'none';
            titleEditBtn.classList.remove('active');

            if (save) {
                const newTitle = titleInput.value.trim() || '🚀 Дорожная карта';
                if (newTitle !== roadmapTitle) {
                    addHistoryEntry(0, '', 'title', roadmapTitle, newTitle);
                }
                roadmapTitle = newTitle;
                titleDisplay.innerHTML = `<span>${newTitle}</span>`;
                localStorage.setItem('ozp_title', newTitle);
                scheduleSaveTasks();
            } else {
                titleInput.value = roadmapTitle;
            }
        }

        titleEditBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            if (isEditingTitle) finishTitleEdit(true);
            else startTitleEdit();
        });

        titleInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault();
                finishTitleEdit(true); } else if (e.key === 'Escape') finishTitleEdit(false);
        });

        titleInput.addEventListener('blur', function() {
            if (isEditingTitle) finishTitleEdit(true);
        });

        // --- НАСТРОЙКИ ---
        document.getElementById('settingsBtn').addEventListener('click', openSettings);
        document.getElementById('settingsModal').addEventListener('click', function(e) {
            if (e.target === this) closeSettings();
        });

        // --- ИСТОРИЯ ---
        let historyVisible = true;

        function toggleHistory() {
            const content = document.getElementById('historyContent');
            const toggle = document.getElementById('historyToggle');
            historyVisible = !historyVisible;
            if (historyVisible) {
                content.classList.remove('collapsed');
                toggle.classList.remove('collapsed');
            } else {
                content.classList.add('collapsed');
                toggle.classList.add('collapsed');
            }
            localStorage.setItem('history_visible', historyVisible ? 'open' : 'closed');
        }

        // --- ДОБАВЛЕНИЕ ЗАПИСИ В ИСТОРИЮ ---
        function addHistoryEntry(taskId, taskName, field, oldValue, newValue) {
            const now = new Date();
            const timeStr = now.toLocaleString('ru-RU', {
                day: '2-digit',
                month: '2-digit',
                year: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });

            let actionText = '';
            if (field === 'status') {
                const statusMap = { 'план': 'План', 'в работе': 'В работе', 'критично': 'Критично', 'готово': 'Готово',
                    'ожидание': 'Ожидание' };
                const oldStatusText = statusMap[oldValue] || oldValue || '—';
                const newStatusText = statusMap[newValue] || newValue || '—';
                actionText =
